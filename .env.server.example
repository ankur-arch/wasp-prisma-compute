# Direct connection string of a Prisma Postgres database for local development.
# The quickest way to get one: npx create-db@latest --env .env.server
# Use the direct host (db.prisma.io), not pooled.db.prisma.io: Prisma Migrate
# needs a direct connection.
DATABASE_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"
